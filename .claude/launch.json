        "-c",
        "import os,http.server,socketserver;socketserver.TCPServer.allow_reuse_address=True;socketserver.TCPServer(('',int(os.environ.get('PORT','8321'))),http.server.SimpleHTTPRequestHandler).serve_forever()"
